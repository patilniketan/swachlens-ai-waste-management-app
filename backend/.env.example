# Copy to .env and fill in. Never commit .env.
# Every variable the backend reads is listed here; anything not listed is unused.

# ---- Required ----
# Postgres connection string (on Neon, use the -pooler host here and the
# direct host for `prisma migrate` commands).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/waste_management?schema=public"
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- Server ----
PORT=5000
# "production" makes email sending mandatory (no console OTP fallback).
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (web portal).
CORS_ORIGINS=http://localhost:5173
# Reverse proxies in front of the API (1 behind a tunnel/load balancer), so
# rate limits see real client IPs. 0 = none.
TRUST_PROXY=0
# Set to false to turn off per-request logging.
ENABLE_REQUEST_LOGGING=true

# ---- Rate limits ----
# Requests per IP per 15 minutes, all /api routes (the portal polls every 10s).
GENERAL_RATE_LIMIT_MAX=1000
# Requests per IP per 15 minutes on /api/auth/* (login, signup, OTP).
AUTH_RATE_LIMIT_MAX=10
# Complaints per user per hour.
COMPLAINT_RATE_LIMIT_MAX=20

# ---- AI ----
# Without a key, uncached complaints get keyword-only features, aiSource=fallback
# and needsManualReview=true. Check a key with: npm run gemini:smoke
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# live   = every complaint goes to Gemini
# cached = known demo descriptions and seed images return stored (simulated)
#          features instantly; anything else goes to Gemini
AI_MODE=cached

# ---- Demo / auth ----
# true  = signup creates verified accounts, no OTP email, login skips the check
# false = email OTP verification required before login
DEMO_MODE=true
# Optional outside production. When empty, OTP codes are printed to the server console.
EMAIL_USER=
EMAIL_PASSWORD=

# ---- Tuning ----
# Upload size limit in bytes; can only lower the 5MB maximum.
MAX_FILE_SIZE=5242880
# Metres.
HOTSPOT_RADIUS_METERS=500
DUPLICATE_RADIUS_METERS=500
# Used when no Resource row exists for today (UTC day).
DEFAULT_WORKERS=15
DEFAULT_HEAVY_VEHICLES=5
# Length of a work shift in minutes; daily plan capacity is
# workers x SHIFT_MINUTES worker-minutes (60-1440).
SHIFT_MINUTES=480
