# Copy to .env and fill in. Never commit .env.

# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/waste_management?schema=public"

PORT=5000
NODE_ENV=development

# Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=

# Without a key, uncached complaints get keyword-only features, aiSource=fallback
# and needsManualReview=true. Check a key with: npm run gemini:smoke
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# live   = every complaint goes to Gemini
# cached = known demo descriptions and seed images return stored (simulated)
#          features instantly; anything else goes to Gemini
AI_MODE=cached

# true  = signup creates verified accounts, no OTP email, login skips the check
# false = email OTP verification required before login
DEMO_MODE=true

# Optional outside production. When empty, OTP codes are printed to the server console.
EMAIL_USER=
EMAIL_PASSWORD=

# Optional tuning (meters)
HOTSPOT_RADIUS_METERS=500
DUPLICATE_RADIUS_METERS=500
